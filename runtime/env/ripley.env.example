# Ripley host-local secrets. Copy to ~/.config/nostromo/secrets/ripley.env on Spark with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<ripley-nostr-secret-key-from-buzz-admin-generate-key>

# Dedicated OpenAI project "nostromo-ripley", enforced monthly cap $27 (WP-1 §8.2).
# Never Parker's key. codex-acp reads OPENAI_API_KEY.
OPENAI_API_KEY=<nostromo-ripley-project-key>
