# Ash host-local secrets. Copy to ~/.config/nostromo/secrets/ash.env on the Mac with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<ash-nostr-secret-key-from-buzz-admin-generate-key>

# Subscription-backed only (NOSTROMO-0001 §30, D-014). Ash authenticates codex-acp through the
# ChatGPT login flow. This file must not define OPENAI_API_KEY or CODEX_API_KEY, and the launcher
# fails closed if either is present in Ash's environment.
