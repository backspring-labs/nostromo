# Shared Buzz relay settings for every agent on this host.
# Copy to ~/.config/nostromo/secrets/buzz-common.env with mode 0600.
# Variable names verified against the buzz-acp README at block/buzz main 3c7f288 (2026-09-07).
BUZZ_RELAY_URL=wss://<jetson-tailscale-hostname>
BUZZ_API_TOKEN=<relay-api-token-when-BUZZ_REQUIRE_AUTH_TOKEN-is-set>
