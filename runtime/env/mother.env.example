# Mother host-local secrets. Copy to ~/.config/nostromo/secrets/mother.env on Spark with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<mother-nostr-secret-key-from-buzz-admin-generate-key>

# Local inference only (NOSTROMO-0001 §35). No provider API keys in this file.
# OpenCode reaches Ollama at http://localhost:11434/v1; the launcher fails closed if a
# metered provider key is present in this agent's environment.
