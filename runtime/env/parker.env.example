# Parker host-local secrets. Copy to ~/.config/nostromo/secrets/parker.env on Spark with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<parker-nostr-secret-key-from-buzz-admin-generate-key>

# Dedicated OpenAI project "nostromo-parker", enforced monthly cap $65 (WP-1 §8.1).
# Never Ripley's key. codex-acp reads OPENAI_API_KEY.
OPENAI_API_KEY=<nostromo-parker-project-key>

# GitHub App "nostromo-parker" (WP-1 §8.7, §8.8). Installation tokens are minted on demand by the
# launcher's credential helper; never store a token here. Never the owner's GitHub credentials.
GITHUB_APP_ID=<nostromo-parker-app-id>
GITHUB_APP_INSTALLATION_ID=<nostromo-parker-installation-id-on-squad-ops>
GITHUB_APP_PRIVATE_KEY_FILE=<path-to-nostromo-parker-app-private-key.pem>
