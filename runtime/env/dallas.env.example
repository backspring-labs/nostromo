# Dallas host-local secrets. Copy to ~/.config/nostromo/secrets/dallas.env on Spark with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<dallas-nostr-secret-key-from-buzz-admin-generate-key>

# Dedicated Anthropic Workspace "nostromo-dallas", Workspace Spend Limit $27 (WP-1 §8.4).
# claude-agent-acp reads ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=<nostromo-dallas-workspace-key>
