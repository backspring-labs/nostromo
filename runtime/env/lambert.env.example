# Lambert host-local secrets. Copy to ~/.config/nostromo/secrets/lambert.env on the Mac with mode 0600.
# Only secrets belong here. Harness, model, workspace, and allowlist come from the runtime manifest.
BUZZ_PRIVATE_KEY=<lambert-nostr-secret-key-from-buzz-admin-generate-key>

# Existing Gemini subscription only (NOSTROMO-0001 D-015). Gemini CLI uses its login flow;
# no GEMINI_API_KEY in this file.
