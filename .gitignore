.env.*
!.env.example
*.env
!*.env.example
*.secret
secrets/
auth.json
credentials*
*.key
*.pem
.nostr*

# Runtime state and logs live outside the repo (NOSTROMO-PLAN-0001 §6.3).
.local/
state/
logs/
*.log

