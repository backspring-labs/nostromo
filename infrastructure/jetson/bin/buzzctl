#!/usr/bin/env bash
# Nostromo wrapper around the pinned Buzz production Compose stack on the Jetson (runs ON the Jetson).
# Replaces upstream run.sh, which hard-codes "-f compose.yml" and therefore cannot load compose.nostromo.yml.
set -euo pipefail
DEPLOY=/mnt/ssd/buzz/deploy
cd "$DEPLOY"
compose() {
  # compose.caddy.yml is included only if present. Deleting it and restarting reverts the host to
  # Tailscale Serve, which is the escape hatch if the certificate path ever breaks.
  # An "&&" statement here would abort under set -e whenever the file is absent, which is the
  # normal case before the switch.
  local extra=()
  if [[ -f compose.caddy.yml ]]; then extra=(-f compose.caddy.yml); fi
  docker compose --env-file buzz.env --env-file secrets.env \
    -f compose.yml -f compose.nostromo.yml ${extra[@]+"${extra[@]}"} "$@"
}
case "${1:-help}" in
  start|up)   compose up -d --wait ;;
  stop|down)  compose down ;;
  restart)    compose up -d --wait --force-recreate relay ;;
  pull)       compose pull --ignore-buildable ;;
  build)      shift || true; compose build "$@" ;;
  status|ps)  shift || true; compose ps "$@" ;;
  logs)       shift || true; compose logs "${@:-relay}" ;;
  config)     compose config ;;
  admin)      shift || true; compose exec relay /usr/local/bin/buzz-admin "$@" ;;
  backup)     exec ./backup.sh ;;
  compose)    shift || true; compose "$@" ;;
  *)
    cat <<'MSG'
Usage: buzzctl <command>
  start            docker compose up -d --wait
  stop             stop containers, keep volumes
  restart          recreate the relay after buzz.env or image changes
  pull             pull the pinned images (skips locally built ones)
  build [svc]      build the locally built images (the TLS terminator)
  status [args]    compose ps
  logs [svc] [-f]  compose logs (default service: relay)
  config           render the merged Compose config
  admin <args>     run buzz-admin inside the relay container (add-member, list-members, migrate, ...)
  backup           run backup.sh
  compose <args>   any docker compose command against this stack (e.g. the rollback in README.md)
MSG
    [[ "${1:-help}" == "help" ]] || exit 1
    ;;
esac
