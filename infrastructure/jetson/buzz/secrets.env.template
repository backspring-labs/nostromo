# Template for /mnt/ssd/buzz/deploy/secrets.env on the Jetson. bootstrap-remote.sh instantiates it ONCE with
# host-generated values (mode 600) and never overwrites it: these values must stay stable across restarts.
# Never commit an instantiated copy. Rotation is a deliberate, backed-up operation (README, "Secrets").
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
# Installed by bin/set-cloudflare-token.sh, which verifies scope before writing. Long-lived by
# necessity — Cloudflare has no short-lived exchange — so it is scoped to DNS edit on one zone and
# its validity is checked by probe.sh rather than discovered at renewal time.
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_DNS_EDIT_TOKEN
