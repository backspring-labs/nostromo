# Nostromo Buzz relay: non-secret configuration. Repo-managed; install.sh overwrites the copy on the Jetson.
# Secrets live only in /mnt/ssd/buzz/deploy/secrets.env on the Jetson (see secrets.env.template).
# The hostname was the tailnet name at bootstrap, then buzz.backspring.xyz, and is now the final
# value below. Settled before WP-5 mints identities (crew/manifest.yaml, plan §9.6).

# Buzz relay image, pinned by multi-arch index digest (arm64 and amd64), built from block/buzz commit
# c045321a7fb3ca8939f28519ce7a555a6f597728 on 2026-09-08. Keep in step with upstream.lock and docs/source-baseline.md.
# HOSTNAME. The relay binds a community to the request Host, so this value IS the community's
# identity and every agent handle is @<this>. It moved from nano.tailc69e7d.ts.net to
# buzz.backspring.xyz on 2026-09-13: Tailscale Serve cannot issue for a name it does not own, and
# the handles have to outlive the tailnet. Changing it again creates a new community.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:496c38cc235db7cbbbe9706e67e5dfe9b14ba987d9fd309a8fe6b81d967151ce

# Relay host and URLs. Tailscale Serve terminates TLS on 443 (tailnet only) and proxies to the relay on
# loopback, so clients use wss:// with no port (README, "TLS").
# --- hostnames --------------------------------------------------------------------------------
# EVERY hostname here is a SEPARATE community. The relay binds a connection to a community by the
# request Host, creating one if it does not exist, and members, channels and events are all keyed
# by community_id. Caddy obtains a certificate per name and passes Host through unchanged.
#
# WRONG EARLIER, CORRECTED: adding a name here does NOT create a community. The relay fails closed —
# "no community is configured for this host", 404, and deliberately never a default tenant. Only
# RELAY_URL's own host is auto-provisioned at startup, which is how all three of ours came to exist.
# A second community is created through the operator control plane:
#   POST /operator/communities  { "host": ..., "initial_owner_pubkey": ... }
# NIP-98 signed by a key in RELAY_OPERATOR_PUBKEYS, against RELAY_OPERATOR_API_ORIGIN. Neither is
# set on this deployment yet. buzz.backspring.xyz exists only because it was RELAY_URL earlier today.
#
# Removing a name here does not delete anything — it makes that community unreachable, which is a
# different thing, and the reason decommissioning a host needs a deliberate deletion as well.
RELAY_HOSTNAMES=nostromo.backspring.xyz, buzz.backspring.xyz

# --- the primary ------------------------------------------------------------------------------
# Two things in Buzz are single-valued and cannot be expressed per community, so one hostname has
# to be canonical for them:
#   BUZZ_MEDIA_BASE_URL  every community's media links are generated with this host
#                        (crates/buzz-relay/src/config.rs: public_base_url is one String)
#   RELAY_URL            NOT read by the relay. It is the buzz-admin CLI's default community, which
#                        is why `deletions submit` without --host targets it. Always pass --host.
BUZZ_DOMAIN=nostromo.backspring.xyz
RELAY_URL=wss://nostromo.backspring.xyz
# MUST be a mapped community host. A neutral deployment-level media host was tried on 2026-09-13
# and does not work: media routes are gated behind tenant binding, so an unmapped host returns
# 404 {"error":"not found"} where a mapped host returns 401 {"error":"authentication failed"}.
# Pointing this at media.backspring.xyz made every media link dead.
#
# The consequence is unavoidable in this version: every community's media links carry the PRIMARY
# community's hostname. Cosmetic between the owner's own communities; a genuine branding leak if a
# second community ever holds other people.
BUZZ_MEDIA_BASE_URL=https://nostromo.backspring.xyz/media
BUZZ_MEDIA_SERVER_DOMAIN=nostromo.backspring.xyz

# Comma-separated, parsed into a Vec<String>. Must list every hostname above or that community's
# browser clients are refused.
BUZZ_CORS_ORIGINS=https://nostromo.backspring.xyz,https://buzz.backspring.xyz

# --- operator control plane -------------------------------------------------------------------
# Empty is the default and disables community provisioning entirely — fail closed. That is why this
# deployment could not create a second community: every community it has was auto-provisioned from
# RELAY_URL at some startup, which is not a mechanism to rely on.
#
# Operators span tenants: they may create communities and bootstrap their owners, which is a larger
# authority than RELAY_OWNER_PUBKEY (a role WITHIN one community). The owner's key is listed here
# for now; automation that provisions communities should get its own operator key rather than
# borrowing the owner's.
RELAY_OPERATOR_PUBKEYS=508cd1c7dbcddcc93b8168923cac49ef28bb02f0e60de549e44b01000d2bce5f
RELAY_OPERATOR_API_ORIGIN=https://nostromo.backspring.xyz

# The relay listens on loopback only (compose.nostromo.yml); the tailnet reaches it through Serve. Never 0.0.0.0.
BUZZ_HTTP_PORT=3000

# Closed relay (plan §9.11): auth tokens and relay membership are mandatory.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. The relay refuses to start in closed mode without one, and the real owner keypair is on hold
# until WP-3 (owner decision, 2026-09-07). The value below is a PLACEHOLDER generated on the Jetson on 2026-09-08
# with buzz-admin generate-key; its secret key was discarded at generation, so nobody can act as this owner and
# the relay is closed and inert. WP-3 replaces it with the real owner pubkey (README, "Owner identity").
# The owner's real identity, minted in Buzz Desktop on 2026-09-13 and held in the Mac's Keychain
# with an independent encrypted backup. npub12zxdr37mehwvjwupdzfretzfau5tkqhsucx72j0yfvqsqrftee0sp8a962
# Replaces the DEV-002 placeholder, whose private half was generated and discarded.
RELAY_OWNER_PUBKEY=508cd1c7dbcddcc93b8168923cac49ef28bb02f0e60de549e44b01000d2bce5f

POSTGRES_DB=buzz
POSTGRES_USER=buzz
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

# --- TLS terminator (compose.caddy.yml) -------------------------------------------------------
# The Jetson's tailnet address. Caddy publishes :443 here and nowhere else, and the public DNS
# record for BUZZ_DOMAIN resolves to this same private address.
TAILNET_IP=100.98.252.95
ACME_EMAIL=jason.f.ladd@gmail.com
# Production. Staging proved the chain on 2026-09-13 (issuer "(STAGING) Artificial Amaranth YE1"),
# so the production rate limit is spent on an attempt already known to work. Put this back to
# https://acme-staging-v02.api.letsencrypt.org/directory before debugging anything certificate-related.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
