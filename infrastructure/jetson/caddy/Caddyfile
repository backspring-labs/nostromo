# TLS for every hostname this relay serves. Each one is a separate community — the relay binds by
# request Host — so this block deliberately takes a LIST, not a single canonical name.
#
# Reachable on the tailnet only: the published port is
# bound to the Jetson's tailnet address, and the DNS record resolves to that same private address,
# so the name is public but the host is not.
#
# CLOUDFLARE_API_TOKEN comes from the host-local secrets file and is never in this repository.

{
	email {$ACME_EMAIL}
	# Staging first. Let's Encrypt's production rate limits are low enough that a misconfigured
	# first attempt can lock the name out for a week; switch-hostname.sh proves the chain against
	# staging, then flips this.
	acme_ca {$ACME_CA}
	# DNS-01 only; nothing inbound is ever opened, so the HTTP challenge is off.
	auto_https disable_redirects
}

{$RELAY_HOSTNAMES} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# Device pairing is a separate service. handle_path strips the /pair prefix, so the pairing
	# relay sees requests at its own root. This must come before the catch-all below.
	handle_path /pair* {
		reverse_proxy pair:5000
	}

	# Everything else is the relay. It binds a community to the Host header, so that must arrive
	# unchanged. Buzz is a WebSocket service; Caddy upgrades transparently.
	handle {
		reverse_proxy relay:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}
