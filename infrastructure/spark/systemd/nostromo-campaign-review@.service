[Unit]
Description=Nostromo bounded campaign review as %i (one provider call, no retries)
After=nostromo-campaign-broker.service network-online.target
Requires=nostromo-campaign-broker.service

[Service]
Type=oneshot
User=%i
ExecStart=/usr/bin/python3 -I /usr/local/lib/nostromo/campaign-review.py %i
TimeoutStartSec=900
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.local/state/nostromo-reviews
MemoryMax=256M
TasksMax=16
LimitCORE=0
