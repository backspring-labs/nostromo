{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow", "git log*": "allow", "git diff*": "allow",
      "gh pr view*": "allow", "gh pr list*": "allow",
      "gh issue view*": "allow", "gh issue list*": "allow"
    },
    "webfetch": "deny",
    "task": "deny",
    "question": "allow",
    "plan_enter": "deny",
    "plan_exit": "deny",
    "external_account": "deny",
    "external_directory": "deny",
    "external_output": "deny"
  }
}
