{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Spark, local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen3.6 35B-A3B (Q4_K_M)"
        }
      }
    }
  },
  "model": "ollama/qwen3.6:35b-a3b",
  "permission": {
    "read": "allow",
    "edit": "deny",
    "write": "deny",
    "bash": {
      "*": "deny",
      "buzz *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow"
    },
    "webfetch": "deny",
    "task": "deny",
    "question": "allow",
    "plan_enter": "deny",
    "plan_exit": "deny",
    "external_account": "deny",
    "external_directory": "deny",
    "external_output": "deny"
  }
}
