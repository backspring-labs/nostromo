{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Spark, local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen3.6 35B-A3B (Q4_K_M)"
        }
      }
    }
  },
  "model": "ollama/qwen3.6:35b-a3b",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git restore*": "allow",
      "git push origin nostromo/brett/*": "allow",
      "git push*": "deny",
      "gh pr create*": "allow",
      "gh pr view*": "allow",
      "gh issue view*": "allow",
      "gh pr merge*": "deny",
      "gh pr review*": "deny",
      "pytest*": "allow",
      "ruff*": "allow",
      "uv pip*": "allow",
      "bash scripts/dev/*": "allow",
      "rm -rf*": "deny",
      "sudo*": "deny",
      "docker*": "deny",
      "curl*": "ask",
      "wget*": "ask",
      "buzz *": "allow"
    },
    "webfetch": "deny",
    "task": "deny",
    "question": "allow",
    "plan_enter": "deny",
    "plan_exit": "deny",
    "external_account": "deny",
    "external_directory": "deny",
    "external_output": "deny"
  }
}
